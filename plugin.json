{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codereview-plugin",
  "version": "0.4.2",
  "description": "经显式授权，对暂存提交做语义审查（OCR 委托或自配模型）；结论仅作建议，不替代静态检查。",
  "author": {
    "name": "Full Stack Skills / PartMe.AI"
  },
  "homepage": "https://github.com/full-stack-plugins/codereview-plugin",
  "repository": "https://github.com/full-stack-plugins/codereview-plugin",
  "license": "Apache-2.0",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "CodeReview（提交语义审查）",
        "shortDescription": "暂存提交的逻辑与安全审查，需显式授权",
        "longDescription": "通过 Open Code Review 选择候选文件和规则，默认由当前宿主智能体审查，也可使用 OCR-managed 模式；提供结构化建议，不替代流程验收或静态检查。",
        "developerName": "Full Stack Skills / PartMe.AI",
        "category": "Developer Tools",
        "capabilities": [],
        "defaultPrompt": [
          "请披露代码外发范围，再询问是否审查本次提交。"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "CodeReview"
    }
  },
  "displayName": "CodeReview（代码变更审查）",
  "displayName_i18n": {
    "zh-CN": "CodeReview（代码变更审查）"
  },
  "description_i18n": {
    "zh-CN": "经显式授权，对暂存提交做语义审查（OCR 委托或自配模型）；结论仅作建议，不替代静态检查。"
  }
}
