{
  "name": "codereview-plugin",
  "version": "0.4.0",
  "description": "Consent-based semantic review of staged commits through Open Code Review delegation or a configured model. Findings remain advisory.",
  "author": {
    "name": "Full Stack Skills / PartMe.AI"
  },
  "skills": "./skills/",
  "interface": {
    "displayName": "CodeReview · Commit Review",
    "shortDescription": "Logic and security review of staged commits, with consent"
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|Shell|exec_command",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|Shell|exec_command",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "Stop",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    }
  ]
}
