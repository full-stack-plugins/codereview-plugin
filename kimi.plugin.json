{
  "name": "codereview-plugin",
  "version": "0.1.0",
  "description": "用户授权后审查候选提交，拒绝后本会话不再提醒。",
  "author": {"name": "Full Stack Skills / PartMe.AI"},
  "skills": "./skills/",
  "interface": {"displayName": "CodeReview", "shortDescription": "可选、可追踪的提交语义审查"},
  "hooks": [
    {"event": "SessionStart", "command": "python3 ./hooks/entry.py --host kimi", "timeout": 10},
    {"event": "UserPromptSubmit", "command": "python3 ./hooks/entry.py --host kimi", "timeout": 10},
    {"event": "PreToolUse", "matcher": "Bash|Shell|exec_command", "command": "python3 ./hooks/entry.py --host kimi", "timeout": 10},
    {"event": "PostToolUse", "matcher": "Bash|Shell|exec_command", "command": "python3 ./hooks/entry.py --host kimi", "timeout": 10},
    {"event": "Stop", "command": "python3 ./hooks/entry.py --host kimi", "timeout": 10}
  ]
}
