{
  "name": "codereview-plugin",
  "version": "0.2.2",
  "description": "Consent-based semantic review of staged commits using Open Code Review delegation or a configured OCR model; findings remain advisory.",
  "author": {
    "name": "Full Stack Skills / PartMe.AI"
  },
  "skills": "./skills/",
  "interface": {
    "displayName": "CodeReview",
    "shortDescription": "Review staged commits with explicit consent"
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|Shell|exec_command",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|Shell|exec_command",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    },
    {
      "event": "Stop",
      "command": "python3 ./hooks/entry.py --host kimi",
      "timeout": 10
    }
  ]
}
